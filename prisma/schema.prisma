generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MediaImage {
  id        String   @id @default(cuid())
  data      Bytes
  mime      String   @default("image/jpeg")
  createdAt DateTime @default(now())
}

model Setting {
  id           String   @id @default("main")
  logo         String?
  popupEnabled Boolean  @default(false)
  popupImage   String?
  popupLink    String?
  popupTitle   String?
  announcement String?
  slides       Json? // [{ image, title, subtitle, cta, link }]
  banners      Json? // [{ image, title, subtitle, cta, link }]
  squareAds    Json? // [{ image, link }] bannieres carrees inserees dans les grilles
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  icon      String?
  image     String?
  order     Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())

  @@index([parentId])
}

model Product {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  description    String      @default("")
  price          Int // en FCFA
  compareAtPrice Int? // prix barré (promo)
  images         String[]
  stock          Int         @default(100)
  rating         Float       @default(4.6)
  reviewsCount   Int         @default(0)
  sold           Int         @default(0)
  featured       Boolean     @default(false)
  isFlashDeal    Boolean     @default(false)
  active         Boolean          @default(true)
  condition      ProductCondition @default(NEUF)
  brand          String?
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([categoryId])
  @@index([featured])
}

enum OrderStatus {
  EN_ATTENTE
  CONFIRMEE
  EN_LIVRAISON
  LIVREE
  ANNULEE
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ProductCondition {
  NEUF
  OCCASION
  RECONDITIONNE
}

model Driver {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  pinHash   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
}

model PromoCode {
  id        String       @id @default(cuid())
  code      String       @unique
  type      DiscountType @default(PERCENT)
  value     Int // pourcentage (1-100) ou montant fixe en FG
  minOrder  Int          @default(0)
  maxUses   Int? // null = illimité
  used      Int          @default(0)
  active    Boolean      @default(true)
  expiresAt DateTime?
  createdAt DateTime     @default(now())
}

model Order {
  id           String      @id @default(cuid())
  reference    String      @unique
  customerName String
  phone        String
  location     String
  note         String?
  status       OrderStatus @default(EN_ATTENTE)
  subtotal     Int
  deliveryFee  Int         @default(0)
  discount     Int         @default(0)
  promoCode    String?
  total        Int
  paid         Boolean     @default(false)
  paidAt       DateTime?
  driverId     String?
  driver       Driver?     @relation(fields: [driverId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([driverId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  image       String?
  price       Int
  quantity    Int

  @@index([orderId])
}
